generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserKind { 
  PARTICULIER
  PROFESSIONNEL
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum AddressType {
  HOME
  BILLING
  SHIPPING
  BUSINESS
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
  FINANCE
  COMPLIANCE
  MARKETING
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  SUSPENDED
  SOLD
  EXPIRED
}

enum CategoryDomain {
  GENERAL
  VEHICLE
  REAL_ESTATE
  JOB
  SERVICE
  ANIMAL
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
  DATE
}

enum PropertyTransactionType {
  SALE
  RENTAL
}

enum EnergyClass {
  A
  B
  C
  D
  E
  F
  G
}

enum ConversationStatus {
  OPEN
  ARCHIVED
  BLOCKED
}

enum MessageKind {
  TEXT
  IMAGE
  FILE
  SYSTEM
  OFFER
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum BusinessVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum StoreStatus {
  DRAFT
  ACTIVE
  PAUSED
  SUSPENDED
}

enum ProfessionalPlanCode {
  ESSENTIEL
  PROFESSIONNEL
  PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model User {
  id String @id @default(cuid())
  email String @unique
  emailVerifiedAt DateTime?
  passwordHash String
  kind UserKind @default(PARTICULIER)
  status UserStatus @default(PENDING_VERIFICATION)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile UserProfile?
  addresses Address[]
  sessions Session[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  roles UserAdminRole[]
  listings Listing[]
  conversationsAsBuyer Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messages Message[]
  offersMade Offer[] @relation("OfferMaker")
  offersReceived Offer[] @relation("OfferRecipient")
  business BusinessProfile?
  stores Store[]
  subscriptions ProfessionalSubscription[]
  @@index([status, createdAt])
}

model UserProfile {
  id String @id @default(cuid())
  userId String @unique
  displayName String?
  firstName String?
  lastName String?
  phone String?
  avatarUrl String?
  locale String @default("fr-FR")
  countryCode String @default("FR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id String @id @default(cuid())
  userId String
  type AddressType @default(HOME)
  label String?
  recipient String?
  line1 String
  line2 String?
  postalCode String
  city String
  region String?
  countryCode String @default("FR")
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault])
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  userAgent String?
  ipHash String?
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model UserAdminRole {
  id String @id @default(cuid())
  userId String
  role AdminRole
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
  @@index([role])
}

model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  domain CategoryDomain @default(GENERAL)
  parentId String?
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  attributes CategoryAttribute[]
  listings Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([domain])
}

model CategoryAttribute {
  id String @id @default(cuid())
  categoryId String
  key String
  label String
  type AttributeType
  unit String?
  required Boolean @default(false)
  filterable Boolean @default(true)
  searchable Boolean @default(false)
  sortOrder Int @default(0)
  config Json?
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options CategoryAttributeOption[]
  values ListingAttributeValue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
}

model CategoryAttributeOption {
  id String @id @default(cuid())
  attributeId String
  value String
  label String
  sortOrder Int @default(0)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
}

model Listing {
  id String @id @default(cuid())
  title String?
  slug String? @unique
  description String?
  priceMinor Int?
  currency String @default("EUR")
  status ListingStatus @default(DRAFT)
  sellerId String
  categoryId String
  storeId String?
  city String?
  postalCode String?
  region String?
  latitude Float?
  longitude Float?
  seller User @relation(fields: [sellerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  attributes ListingAttributeValue[]
  vehicle VehicleDetails?
  property PropertyDetails?
  energy PropertyEnergyPerformance?
  conversations Conversation[]
  offers Offer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  @@index([status, categoryId])
  @@index([sellerId, createdAt])
  @@index([storeId, status, publishedAt])
  @@index([status, city, publishedAt])
  @@index([status, priceMinor])
  @@index([latitude, longitude])
}

model ListingAttributeValue {
  id String @id @default(cuid())
  listingId String
  attributeId String
  valueText String?
  valueNumber Float?
  valueBoolean Boolean?
  valueJson Json?
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([listingId, attributeId])
  @@index([attributeId, valueText])
  @@index([attributeId, valueNumber])
}

model VehicleDetails {
  id String @id @default(cuid())
  listingId String @unique
  registrationPlateHash String?
  registrationPlateLast4 String?
  dataSource String?
  dataVerifiedAt DateTime?
  make String?
  model String?
  version String?
  firstRegistrationDate DateTime?
  modelYear Int?
  fuel String?
  transmission String?
  bodyType String?
  powerKw Int?
  fiscalPowerCv Int?
  co2GKm Int?
  euroStandard String?
  seats Int?
  doors Int?
  color String?
  mileageKm Int?
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PropertyDetails {
  id String @id @default(cuid())
  listingId String @unique
  transactionType PropertyTransactionType
  propertyType String
  surfaceM2 Float
  rooms Int?
  bedrooms Int?
  furnished Boolean @default(false)
  floor Int?
  totalFloors Int?
  landM2 Float?
  postalCode String?
  city String?
  countryCode String @default("FR")
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PropertyEnergyPerformance {
  id String @id @default(cuid())
  listingId String @unique
  dpeNumber String?
  dpeDate DateTime?
  validUntil DateTime?
  isExempt Boolean @default(false)
  exemptionReason String?
  energyClass EnergyClass?
  climateClass EnergyClass?
  energyConsumptionKwhM2Year Float?
  ghgKgCo2M2Year Float?
  annualCostMinMinor Int?
  annualCostMaxMinor Int?
  energyPriceReferenceYears String?
  excessiveConsumption Boolean @default(false)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([energyClass])
  @@index([climateClass])
}

model Conversation {
  id String @id @default(cuid())
  listingId String
  buyerId String
  sellerId String
  status ConversationStatus @default(OPEN)
  buyerLastReadAt DateTime?
  sellerLastReadAt DateTime?
  lastMessageAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer User @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller User @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]
  offers Offer[]
  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  kind MessageKind @default(TEXT)
  body String?
  attachmentUrl String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  offer Offer?
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Offer {
  id String @id @default(cuid())
  conversationId String
  listingId String
  messageId String? @unique
  makerId String
  recipientId String
  parentOfferId String?
  amountMinor Int
  currency String @default("EUR")
  status OfferStatus @default(PENDING)
  expiresAt DateTime?
  respondedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  maker User @relation("OfferMaker", fields: [makerId], references: [id], onDelete: Cascade)
  recipient User @relation("OfferRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  parentOffer Offer? @relation("OfferChain", fields: [parentOfferId], references: [id])
  counterOffers Offer[] @relation("OfferChain")
  @@index([conversationId, createdAt])
  @@index([listingId, status])
  @@index([recipientId, status])
}

model BusinessProfile {
  id String @id @default(cuid())
  userId String @unique
  legalName String
  tradeName String?
  siren String? @unique
  siret String? @unique
  vatNumber String?
  legalForm String?
  nafCode String?
  registrationCountry String @default("FR")
  headquartersAddress String?
  headquartersPostalCode String?
  headquartersCity String?
  verificationStatus BusinessVerificationStatus @default(NOT_STARTED)
  verificationProvider String?
  verificationReference String?
  verifiedAt DateTime?
  lastRegistryCheckAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores Store[]
  @@index([verificationStatus])
  @@index([siren])
  @@index([siret])
}

model Store {
  id String @id @default(cuid())
  ownerId String
  businessId String?
  slug String @unique
  name String
  description String?
  logoUrl String?
  coverUrl String?
  websiteUrl String?
  phone String?
  email String?
  city String?
  postalCode String?
  countryCode String @default("FR")
  status StoreStatus @default(DRAFT)
  isVerified Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  business BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  listings Listing[]
  @@index([ownerId, status])
  @@index([businessId])
}

model ProfessionalPlan {
  id String @id @default(cuid())
  code ProfessionalPlanCode @unique
  name String
  description String?
  monthlyPriceMinor Int
  yearlyPriceMinor Int?
  currency String @default("EUR")
  maxActiveListings Int?
  maxStores Int @default(1)
  analyticsEnabled Boolean @default(false)
  autoRenewListings Boolean @default(false)
  prioritySupport Boolean @default(false)
  featuredCreditsMonthly Int @default(0)
  bulkImportEnabled Boolean @default(false)
  apiFeedEnabled Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscriptions ProfessionalSubscription[]
}

model ProfessionalSubscription {
  id String @id @default(cuid())
  userId String
  planId String
  status SubscriptionStatus @default(TRIALING)
  trialEndsAt DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  externalProvider String?
  externalSubscriptionId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan ProfessionalPlan @relation(fields: [planId], references: [id])
  @@index([userId, status])
  @@index([planId, status])
}
